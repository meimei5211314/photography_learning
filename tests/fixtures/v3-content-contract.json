  "tasks": [
    {
      "id": "three-apertures",
      "criteria": [
        "杯子上的同一处细节在三张里都清楚。",
        "能指出背景清晰范围的变化，而不只评价哪张好看。",
        "写明机位、主体距离与背景距离是否保持一致。"
      ]
    },
    {
      "id": "stop-time",
      "criteria": [
        "至少一张表现拖影，一张明显减少拖影。",
        "背景足够稳定，便于判断主体运动。",
        "记录快门与实际效果，不把建议数值当作保证。"
      ]
    },
    {
      "id": "window-portrait",
      "criteria": [
        "关键眼睛清楚；若人物在动，快门足够短。",
        "能说明白纸板对阴影的影响。",
        "背景没有从头顶穿出的杂物或抢眼亮斑。"
      ]
    },
    {
      "id": "composition-walk",
      "criteria": [
        "保留至少一组有意改进的前后对照。",
        "能说明引导线指向哪里。",
        "主题不依赖长段解释也能看懂。"
      ]
    },
    {
      "id": "focal-distance",
      "criteria": [
        "第一组机位不变，第二组主体画面大小近似。",
        "能区分取景范围变化与透视变化。",
        "记录焦距是实际值还是等效值。"
      ]
    },
    {
      "id": "night-city",
      "criteria": [
        "建筑边缘清楚，能看出相机保持稳定。",
        "保留两张不同时间表现的照片。",
        "能指出哪些高光重要，哪些小光点允许变成纯亮。"
      ]
    },
    {
      "id": "color-story",
      "criteria": [
        "能正确说明相机 K 值升高时画面通常变暖。",
        "三张主体亮度近似，避免把明暗误认为颜色差异。",
        "能说明哪个版本追求还原，哪个版本追求表达。"
      ]
    },
    {
      "id": "mini-story",
      "criteria": [
        "三张各有职责，不是同一角度的三张近似照。",
        "每张都能说出一个明确的技术取舍。",
        "完成一份包含“下次只改什么”的复盘。"
      ]
    },
    {
      "id": "r6-first",
      "criteria": [
        "能说出所选模式下光圈、快门、ISO 分别由谁决定。",
        "已有两张主要变量清楚、设置已记录的对照照片。",
        "已放大检查焦点与动作，能指出一项具体证据。",
        "已保留原片，并写出下一次只改什么。"
      ]
    },
    {
      "id": "portrait-outdoor",
      "criteria": [
        "两种光线各有一张可比较照片，并记录了人物与光源方向。",
        "选中照片的关键眼睛清楚、头部周围没有无意的相切。",
        "能说明自己怎样处理脸与背景的亮度取舍。",
        "后期保留自然肤质，导出文件已重新打开检查。"
      ]
    },
    {
      "id": "group-portrait",
      "criteria": [
        "所有人物都经过放大检查，而非只看检测框。",
        "能根据试拍结果解释人物排列和光圈选择。",
        "画面边缘没有无意切断手脚或挤压边缘人物。",
        "选中照片中各人的受光和肤色没有明显不合理差异。"
      ]
    },
    {
      "id": "street-day",
      "criteria": [
        "记录了等待的关系和固定使用的焦距。",
        "三张照片的时机不同，能指出哪张主体轮廓更清楚。",
        "快门表现符合自己的意图，重要边缘经过检查。",
        "选片与处理理由具体，拍摄过程尊重现场人物的意愿。"
      ]
    },
    {
      "id": "street-night",
      "criteria": [
        "能区分主体拖影、全画面晃动与光源条纹的不同证据。",
        "保留一张符合清楚人物目标的照片，或明确记录为什么条件不足并重选位置。",
        "慢门实验被标注为有意运动表现，没有与失败的发虚混为一谈。",
        "后期没有为消除所有暗部和噪点而破坏夜景层次。"
      ]
    },
    {
      "id": "edit-series",
      "criteria": [
        "原片与导出副本分开保留，且文件能够打开。",
        "三张照片各自提供不同信息，顺序有可解释的理由。",
        "每张的主要调整有问题依据，能够指出前后差别。",
        "组照风格连贯，导出副本已重新检查，并写下下一次拍摄改进项。"
      ]
    }
  ]
}
